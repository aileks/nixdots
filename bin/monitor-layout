set -Eeuo pipefail

main_output=DP-4
portrait_output=HDMI-A-2
action=${1:-restore}
state_file="${XDG_RUNTIME_DIR:?}/mango-monitor-layout"

if [[ $action == watch ]]; then
  previous=""
  while IFS= read -r update; do
    # Sleeping outputs retain their geometry; only layout changes need work.
    topology=$(jq -c '[.monitors[] | {name, x, y, width, height, scale}] | sort_by(.name)' <<<"$update")
    [[ $topology == "$previous" ]] && continue
    previous=$topology
    "$0" restore
  done < <(mmsg watch all-monitors)
  exit 1
fi

case "$action" in
  dual | main | portrait | restore) ;;
  *)
    printf 'Usage: monitor-layout [dual|main|portrait|restore|watch]\n' >&2
    exit 2
    ;;
esac

exec 9>"${state_file}.lock"
flock 9
before=$(mmsg get all-monitors)
focused=$(mmsg get focusing-client)
outputs=$(wlr-randr --json)

has_output() {
  jq -e --arg name "$1" 'any(.[]; .name == $name)' <<<"$outputs" >/dev/null
}

requested=$action
if [[ $action == restore ]]; then
  requested=dual
  [[ ! -r $state_file ]] || read -r requested <"$state_file"
fi

if [[ $requested == dual ]] && has_output "$main_output" && has_output "$portrait_output"; then
  layout=dual
elif [[ $requested == portrait ]] && has_output "$portrait_output"; then
  layout=portrait
elif has_output "$main_output"; then
  layout=main
elif has_output "$portrait_output"; then
  layout=portrait
else
  # Leave unfamiliar connected outputs usable with Mango's default layout.
  exit 0
fi

args=()
configure_output() {
  local name=$1 width=$2 height=$3 x=$4 y=$5 transform=$6 mode
  # Use the advertised rate, including its fractional part, nearest 200 Hz.
  mode=$(jq -er --arg name "$name" --argjson width "$width" --argjson height "$height" '
    .[] | select(.name == $name) | .modes
    | map(select(.width == $width and .height == $height and ((.refresh - 200) | fabs) < 1))
    | min_by((.refresh - 200) | fabs)
    | select(. != null) | "\(.width)x\(.height)@\(.refresh)Hz"
  ' <<<"$outputs")
  if ! jq -e --arg name "$name" --arg transform "$transform" \
    --argjson width "$width" --argjson height "$height" --argjson x "$x" --argjson y "$y" '
      any(.[]; .name == $name and .enabled and .scale == 1 and .transform == $transform
        and .position.x == $x and .position.y == $y
        and any(.modes[]; .current and .width == $width and .height == $height
          and ((.refresh - 200) | fabs) < 1))
    ' <<<"$outputs" >/dev/null; then
    args+=(--output "$name" --on --mode "$mode" --pos "$x,$y" --transform "$transform" --scale 1)
  fi
}

disable_output() {
  if jq -e --arg name "$1" 'any(.[]; .name == $name and .enabled)' <<<"$outputs" >/dev/null; then
    args+=(--output "$1" --off)
  fi
}

case "$layout" in
  dual)
    configure_output "$main_output" 2560 1440 1080 240 normal
    configure_output "$portrait_output" 1920 1080 0 0 90
    ;;
  main)
    configure_output "$main_output" 2560 1440 0 0 normal
    disable_output "$portrait_output"
    ;;
  portrait)
    configure_output "$portrait_output" 1920 1080 0 0 90
    disable_output "$main_output"
    ;;
esac

if ((${#args[@]})); then
  wlr-randr "${args[@]}"
fi
if [[ $action != restore ]]; then
  printf '%s\n' "$requested" >"$state_file"
fi

# tagmon changes focus and views. Save them above, move clients, then restore.
moved=false
while IFS=$'\t' read -r id output tags; do
  case "$layout" in
    dual)
      target=$main_output
      [[ $tags != 8 ]] || target=$portrait_output
      ;;
    main) target=$main_output ;;
    portrait) target=$portrait_output ;;
  esac
  [[ $output != "$target" ]] || continue
  mmsg dispatch "tagmon,$target,1" "client,$id" >/dev/null
  moved=true
done < <(mmsg get all-clients | jq -r '
  .clients[]
  | select((.is_scratchpad or .is_minimized or .is_swallowedby) | not)
  | select(.tags | length > 0)
  | [.id, .monitor, (.tags | sort | map(tostring) | join("|"))] | @tsv
')

after=$(mmsg get all-monitors)
while IFS= read -r output; do
  tags=$(jq -r --arg name "$output" --arg layout "$layout" --arg main "$main_output" '
    [.monitors[] | select(.name == $name) | .active_tags[]
      | select($layout != "dual" or $name != $main or . != 8)]
    | map(tostring) | join("|")
  ' <<<"$before")
  [[ -n $tags ]] || tags=1
  if [[ $layout == dual && $output == "$portrait_output" ]]; then
    tags=8
  fi
  current=$(jq -r --arg name "$output" '
    .monitors[] | select(.name == $name) | .active_tags | map(tostring) | join("|")
  ' <<<"$after")
  if [[ $current != "$tags" ]]; then
    mmsg dispatch "viewcrossmon,$tags,$output" >/dev/null
    moved=true
  fi
done < <(jq -r '.monitors[] | select(.width > 0 and .height > 0) | .name' <<<"$after")

if $moved || ((${#args[@]})); then
  id=$(jq -r '.id // empty' <<<"$focused")
  if [[ -n $id ]] && mmsg get client "$id" | jq -e '.is_visible' >/dev/null; then
    mmsg dispatch focusid "client,$id" >/dev/null
  else
    output=$(jq -r '.monitors[] | select(.active) | .name' <<<"$before")
    if ! jq -e --arg name "$output" 'any(.monitors[]; .name == $name and .width > 0)' <<<"$after" >/dev/null; then
      output=$main_output
      [[ $layout != portrait ]] || output=$portrait_output
    fi
    mmsg dispatch "focusmon,$output" >/dev/null
  fi
fi
