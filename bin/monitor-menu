set -Eeuo pipefail
selected=$(printf 'Dual\nMain only\nPortrait only\n' | wmenu -i -p displays) || exit 0
case "$selected" in
  Dual) layout=dual ;;
  'Main only') layout=main ;;
  'Portrait only') layout=portrait ;;
  *) exit 0 ;;
esac
if ! monitor-layout "$layout"; then
  desktop-feedback status "Display layout could not be applied"
fi
