#!/usr/bin/env bash
button="${BLOCK_BUTTON:-0}"
state_file="${XDG_CACHE_HOME:-$HOME/.cache}/bar-clock-format"
idx=0
[[ -f "$state_file" ]] && read -r idx <"$state_file"

case "$button" in
  1)
    idx=$(((idx + 1) % 2))
    mkdir -p "${state_file%/*}"
    printf '%s\n' "$idx" >"$state_file"
    ;;
esac

case "$idx" in
  1) fmt='%Y-%m-%d %H:%M' ;;
  *) fmt='%a %d %b %H:%M' ;;
esac

printf '^c#BBB3A9^%s^d^' "$(date +"$fmt")"
