#!/usr/bin/env bash

set -Eeuo pipefail

channel=${1:-}
value=${2:-}
if [[ -z $channel || -z $value ]]; then
  printf 'usage: osd <channel> <value> [alternate]\n' >&2
  exit 2
fi
shift 2

pipe="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/osd-$channel.pipe"
[[ -p $pipe ]] || exit 0

# open read-write so a missing daemon never blocks the write
{
  printf '%s' "$value"
  if (($#)); then
    printf ' %s' "$*"
  fi
  printf '\n'
} <>"$pipe"
