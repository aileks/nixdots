set -Eeuo pipefail

if [[ ${1:-} != watch ]]; then
  exec systemd-inhibit --what=idle --who=screenrecord --why='Screen recording' \
    --mode=block "$0" watch "$@"
fi
shift
pid=${1:-}
expected_start=${2:-}
[[ $pid =~ ^[0-9]+$ && $expected_start =~ ^[0-9]+$ ]] || exit 2

recording_is_live() {
  local stat
  local -a fields
  IFS= read -r stat <"/proc/$pid/stat" 2>/dev/null || return 1
  # The command name in parentheses can contain spaces.
  read -r -a fields <<<"${stat##*) }"
  [[ ${fields[0]} != Z && ${fields[19]} == "$expected_start" ]]
}

recording_is_live || exit 1
printf 'READY\n'
# swayidle honors logind's idle inhibitor for all of its timeout commands.
while recording_is_live; do
  sleep 1
done
