set -euo pipefail

case "${1:-toggle}" in
  apply)
    exec systemctl --user try-restart night-light.service
    ;;
  toggle)
    if systemctl --user is-active --quiet night-light.service; then
      systemctl --user stop night-light.service
      desktop-feedback status "Night light off" || true
    else
      systemctl --user start night-light.service
      desktop-feedback status "Night light on" || true
    fi
    ;;
  *)
    echo "Usage: night-light [toggle|apply]" >&2
    exit 2
    ;;
esac
