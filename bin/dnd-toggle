set -Eeuo pipefail

if ! pause_level=$(dunstctl get-pause-level); then
  desktop-feedback status "Do not disturb state unavailable" || true
  exit 1
fi

if ((pause_level > 0)); then
  if ! dunstctl set-pause-level 0; then
    desktop-feedback status "Do not disturb change failed" || true
    exit 1
  fi
  desktop-feedback status "Do not disturb off" || true
else
  if ! dunstctl set-pause-level 90; then
    desktop-feedback status "Do not disturb change failed" || true
    exit 1
  fi
  desktop-feedback status "Do not disturb on" || true
fi
