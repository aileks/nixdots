#!/usr/bin/env bash

set -Eeuo pipefail

state_dir="${DOTFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles}"
monitors_destination="$state_dir/monitors.lua"
workspaces_destination="$state_dir/workspaces.lua"
topology_destination="$state_dir/monitor-topology.json"
mkdir -p "$state_dir"

if [[ -n ${MONITORS_JSON:-} ]]; then
  monitors=$MONITORS_JSON
else
  for _ in {1..30}; do
    if monitors=$(hyprctl -j monitors all 2>/dev/null); then
      break
    fi
    sleep 1
  done
fi
[[ ${monitors:-} == \[* ]] || exit 1

active_monitors=$(jq -c '[.[] | select(.disabled != true)]' <<<"$monitors")
monitor_count=$(jq 'length' <<<"$active_monitors")
((monitor_count > 0)) || exit 1

main=$(jq -r '
  [.[] | select(any(.availableModes[]?; startswith("2560x1440@")))]
  | first | .name // empty
' <<<"$active_monitors")
side=$(jq -r --arg main "$main" '
  [.[] | select(.name != $main) | select(any(.availableModes[]?; startswith("1920x1080@")))]
  | first | .name // empty
' <<<"$active_monitors")

lua_string() {
  jq -Rn --arg value "$1" '$value'
}

best_mode() {
  local output=$1 resolution=$2
  jq -r --arg output "$output" --arg resolution "$resolution" '
    .[] | select(.name == $output)
    | [.availableModes[]? | select(startswith($resolution + "@"))
       | { mode: sub("Hz$"; ""), delta: ((split("@")[1] | sub("Hz$"; "") | tonumber) - 200 | fabs) }]
    | sort_by(.delta) | first | .mode // "preferred"
  ' <<<"$active_monitors"
}

selected_mode() {
  local output=$1 resolution=${2:-}
  if [[ -n $resolution ]]; then
    best_mode "$output" "$resolution"
  else
    printf 'preferred\n'
  fi
}

monitors_tmp="$state_dir/monitors.lua.new"
workspaces_tmp="$state_dir/workspaces.lua.new"
topology_tmp="$state_dir/monitor-topology.json.new"
topology_kind=unknown
focus_output=
main_mode=
side_mode=
output_mode=

{
  printf '%s\n' '-- Generated by configure-monitors. Do not edit.'
  if ((monitor_count >= 2)) && [[ -n $main && -n $side ]]; then
    topology_kind=dual
    focus_output=$main
    main_mode=$(selected_mode "$main" 2560x1440)
    side_mode=$(selected_mode "$side" 1920x1080)
    printf 'hl.monitor({ output = %s, mode = %s, position = "1080x0", scale = 1 })\n' \
      "$(lua_string "$main")" "$(lua_string "$main_mode")"
    printf 'hl.monitor({ output = %s, mode = %s, position = "0x-240", scale = 1, transform = 1 })\n' \
      "$(lua_string "$side")" "$(lua_string "$side_mode")"
  elif ((monitor_count == 1)); then
    focus_output=$(jq -r '.[0].name' <<<"$active_monitors")
    if [[ $focus_output == "$main" ]]; then
      topology_kind="main-only"
      output_mode=$(selected_mode "$focus_output" 2560x1440)
      transform=
    elif [[ $focus_output == "$side" ]]; then
      topology_kind="portrait-only"
      output_mode=$(selected_mode "$focus_output" 1920x1080)
      transform=', transform = 1'
    else
      topology_kind="unknown-single"
      output_mode=preferred
      transform=
    fi
    printf 'hl.monitor({ output = %s, mode = %s, position = "0x0", scale = 1%s })\n' \
      "$(lua_string "$focus_output")" "$(lua_string "$output_mode")" "$transform"
  else
    topology_kind="multi-unknown"
    focus_output=$(jq -r '.[0].name' <<<"$active_monitors")
    printf 'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })\n'
  fi
} >"$monitors_tmp"

{
  printf '%s\n' '-- Generated by configure-monitors. Do not edit.'
  if [[ $topology_kind == dual ]]; then
    for workspace in {1..7}; do
      printf 'hl.workspace_rule({ workspace = "%s", monitor = %s, persistent = true, default = %s })\n' \
        "$workspace" "$(lua_string "$main")" "$([[ $workspace == 1 ]] && printf true || printf false)"
    done
    printf 'hl.workspace_rule({ workspace = "8", monitor = %s, persistent = true, default = true })\n' \
      "$(lua_string "$side")"
  else
    for workspace in {1..8}; do
      printf 'hl.workspace_rule({ workspace = "%s", monitor = %s, persistent = true, default = %s })\n' \
        "$workspace" "$(lua_string "$focus_output")" "$([[ $workspace == 1 ]] && printf true || printf false)"
    done
  fi
} >"$workspaces_tmp"

jq -n --arg kind "$topology_kind" --arg main "$main" --arg side "$side" \
  --arg focus "$focus_output" --arg mainMode "$main_mode" --arg sideMode "$side_mode" \
  --arg outputMode "$output_mode" --argjson outputs "$active_monitors" '
  {
    kind: $kind,
    outputs: ($outputs | map({
      connector: .name,
      make: (.make // ""),
      model: (.model // ""),
      serial: (.serial // ""),
      selectedMode: (if .name == $main and $mainMode != "" then $mainMode
        elif .name == $side and $sideMode != "" then $sideMode
        elif .name == $focus and $outputMode != "" then $outputMode
        else "preferred" end)
    }) | sort_by(.connector))
  }
' >"$topology_tmp"

changed=0
for pair in \
  "$monitors_tmp:$monitors_destination" \
  "$workspaces_tmp:$workspaces_destination" \
  "$topology_tmp:$topology_destination"; do
  source=${pair%%:*}
  destination=${pair#*:}
  if [[ ! -f $destination ]] || ! cmp -s "$source" "$destination"; then
    install -m 0644 "$source" "$destination"
    changed=1
  else
    rm -f "$source"
  fi
done

if ((changed)) && [[ ${MONITOR_SKIP_RELOAD:-0} != 1 ]]; then
  hyprctl reload
fi
if [[ -n $focus_output && ${MONITOR_SKIP_FOCUS:-0} != 1 ]]; then
  hyprctl dispatch "hl.dsp.focus({ monitor = $(lua_string "$focus_output") })"
fi
