button="${BLOCK_BUTTON:-0}"

case "$button" in
  1 | 3) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  4) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  5) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%- ;;
esac

if ! state=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null); then
  printf '<span foreground="#58534C">n/a</span>\n'
  exit 0
fi
vol=${state#Volume: }
if [[ "$vol" == *'[MUTED]'* ]]; then
  printf '<span foreground="#B34A45">mute</span>\n'
else
  awk -v v="$vol" 'BEGIN { printf "<span foreground=\"#879B5C\">%.0f%%</span>\n", v * 100 }'
fi
