read -r mem used total < <(free --bytes | awk '/^Mem/ { printf "%.0f %.1f %.1f\n", $3 / $2 * 100, $3 / 1024^3, $2 / 1024^3 }')
temp=""
for d in /sys/class/hwmon/hwmon*; do
  if [[ "$(cat "$d/name" 2>/dev/null)" == k10temp ]]; then
    inputs=()
    fallback="$d/temp1_input"
    for label in "$d"/temp*_label; do
      [[ -r $label ]] || continue
      input="${label%_label}_input"
      [[ -r $input ]] || continue
      case "$(cat "$label")" in
        Tccd*) inputs+=("$input") ;;
        Tdie) fallback="$input" ;;
      esac
    done
    # Average the CPU chiplets; older CPUs may only expose Tdie or Tctl.
    if ((${#inputs[@]} == 0)) && [[ -r $fallback ]]; then
      inputs+=("$fallback")
    fi
    if ((${#inputs[@]} > 0)); then
      temp=$(awk '{ sum += $1 } END { if (NR) printf "%.0f", sum / NR / 1000 }' "${inputs[@]}")
    fi
    break
  fi
done
text="<span foreground=\"#6785A1\">RAM $mem%</span>"
if [[ -n $temp ]]; then
  text+=" <span foreground=\"#E17A3F\">$temp°C</span>"
fi
storage=$(df -h --output=used,size,avail / | awk 'NR == 2 { printf "%s / %s used, %s free", $1, $2, $3 }')
jq -cn --arg text "$text" \
  --arg tooltip "RAM: $used / $total GiB
CPU temperature: ${temp:-unavailable}${temp:+°C}
Root filesystem: $storage
Click: btop" \
  '{text: $text, tooltip: $tooltip}'
