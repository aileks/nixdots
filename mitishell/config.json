{
  "version": 2,
  "bar": {
    "outputs": ["*"],
    "height": 36,
    "marginTop": 6,
    "marginHorizontal": 4,
    "systemMetrics": "separate",
    "layout": {
      "left": ["workspaces", "windowTitle"],
      "center": ["weather", "media", "clock"],
      "right": [
        "updates",
        "status",
        "system",
        "audio",
        "bluetooth",
        "notifications",
        "quickSettings",
        "tray",
        "power"
      ],
      "hidden": ["network", "keyboardLayout"]
    }
  },
  "clock": {
    "format": "24h",
    "showDate": true,
    "timezones": null
  },
  "calendar": {
    "showWeekNumbers": false
  },
  "weather": {
    "enabled": true,
    "units": "auto",
    "location": ""
  },
  "motion": {
    "enabled": true,
    "reduced": false
  },
  "font": {
    "family": "Maple Mono",
    "monoFamily": "Maple Mono NF"
  },
  "clipboard": {
    "enabled": true,
    "maxEntries": 15
  }
}
