+/* Scratchpad ownership follows the managed client, including swallowed windows. */
+void
+setscratch(const Arg *arg)
+{
+	Client *c = selmon->sel;
+
+	if (!c)
+		return;
+	if (c != scratchpad) {
+		releasescratch(NULL);
+		setfullscreen(c, 0);
+		scratchpadwasfloating = c->isfloating;
+		scratchpad = c;
+	}
+	setfullscreen(c, 0);
+	c->isfloating = 1;
+	c->tags = 0;
+	focus(NULL);
+	arrange(c->mon);
+}
+
+void
+showscratch(void)
+{
+	Client *c = scratchpad;
+	Monitor *m = selmon;
+	int moved = c->mon != m;
+	int x, y, w, h;
+
+	setfullscreen(c, 0);
+	c->isfloating = 1;
+	sendmon(c, m);
+	c->tags = m->tagset[m->seltags];
+	w = MIN(c->w, MAX(1, m->ww - 2 * c->bw));
+	h = MIN(c->h, MAX(1, m->wh - 2 * c->bw));
+	x = moved ? m->wx + (m->ww - w - 2 * c->bw) / 2 : c->x;
+	y = moved ? m->wy + (m->wh - h - 2 * c->bw) / 2 : c->y;
+	x = MAX(m->wx, MIN(x, m->wx + m->ww - w - 2 * c->bw));
+	y = MAX(m->wy, MIN(y, m->wy + m->wh - h - 2 * c->bw));
+	resizeclient(c, x, y, w, h);
+	focus(c);
+	arrange(m);
+}
+
+void
+releasescratch(const Arg *arg)
+{
+	Client *c = scratchpad;
+
+	if (!c)
+		return;
+	showscratch();
+	c->isfloating = scratchpadwasfloating;
+	scratchpad = NULL;
+	arrange(c->mon);
+}
+
+void
+togglescratch(const Arg *arg)
+{
+	if (!scratchpad)
+		return;
+	if (scratchpad->mon == selmon && ISVISIBLE(scratchpad)) {
+		scratchpad->tags = 0;
+		focus(NULL);
+		arrange(selmon);
+	} else
+		showscratch();
 }
 
