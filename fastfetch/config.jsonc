{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "NixOS_small",
    "padding": {
      "top": 5,
      "right": 6,
    },
  },
  "modules": [
    "break",
    {
      "type": "host",
      "key": " host",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": " cpu",
      "showPeCoreCount": true,
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": " memory",
      "keyColor": "green",
    },
    {
      "type": "swap",
      "key": "󰓡 swap",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": "\u001b[90m┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈",
    },
    {
      "type": "os",
      "key": " os",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": " kernel",
      "keyColor": "yellow",
    },
    {
      "type": "command",
      "key": "󰏖 pkgs",
      "keyColor": "yellow",
      "text": "nix-store -q --requisites /run/current-system/sw | wc -l",
    },
    {
      "type": "shell",
      "key": " shell",
      "keyColor": "yellow",
    },
    {
      "type": "terminalfont",
      "key": " font",
      "keyColor": "yellow",
    },
    {
      "type": "terminal",
      "key": " term",
      "keyColor": "yellow",
    },
    {
      "type": "custom",
      "format": "\u001b[90m┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈",
    },
    {
      "type": "command",
      "key": "󰃭 age",
      "keyColor": "red",
      "text": "birth=$(stat -c %W / 2>/dev/null); current=$(date +%s); if [ \"${birth:-0}\" -gt 0 ] 2>/dev/null && [ \"$birth\" -le \"$current\" ]; then echo $(((current - birth) / 86400)) days; else echo unknown; fi",
    },
    {
      "type": "uptime",
      "key": " uptime",
      "keyColor": "red",
    },
    "break",
  ],
}
